{
  "name": "image-gallery-kit-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace image-gallery-kit-docs",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "npm run build --workspace image-gallery-kit",
    "build:docs": "npm run build --workspace image-gallery-kit-docs",
    "preview:docs": "npm run preview --workspace image-gallery-kit-docs",
    "test": "npm run test --workspace image-gallery-kit",
    "test:watch": "npm run test:watch --workspace image-gallery-kit",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:package",
    "bump": "npm version --workspace image-gallery-kit",
    "clean": "rm -rf packages/*/dist apps/docs/docs/.vitepress/dist apps/docs/docs/.vitepress/cache",
    "release:dry": "npm publish --workspace image-gallery-kit --dry-run",
    "release": "npm publish --workspace image-gallery-kit"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  }
}
