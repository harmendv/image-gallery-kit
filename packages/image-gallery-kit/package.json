{
  "name": "image-gallery-kit",
  "version": "0.1.0",
  "type": "module",
  "description": "SSR-safe Vue image gallery package with animated grid, dialog carousel, and bento view.",
  "license": "ISC",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/image-gallery-kit.umd.cjs",
  "module": "./dist/image-gallery-kit.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/image-gallery-kit.js",
      "require": "./dist/image-gallery-kit.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/jsdom": "^21.1.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.18",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.13"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
