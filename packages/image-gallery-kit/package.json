{
  "name": "image-gallery-kit",
  "version": "0.3.0",
  "type": "module",
  "description": "SSR-safe Vue image gallery package with animated grid, dialog carousel, and bento view.",
  "license": "MIT",
  "author": "Harmen de Vries",
  "keywords": [
    "vue",
    "vue3",
    "image-gallery",
    "lightbox",
    "carousel",
    "masonry",
    "gallery",
    "ssr",
    "component"
  ],
  "homepage": "https://github.com/harmendv/image-gallery-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harmendv/image-gallery-kit.git"
  },
  "bugs": {
    "url": "https://github.com/harmendv/image-gallery-kit/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/image-gallery-kit.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/image-gallery-kit.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "gsap": "^3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "gsap": "^3.15.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  }
}
